generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  MENTOR
  INTERN
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password      String
  role          UserRole  @default(INTERN)
  firstName     String
  lastName      String
  phone         String?
  department    String?
  program       String?
  isActive      Boolean   @default(true)
  refreshToken  String?
  resetToken    String?
  resetTokenExp DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  notifications     Notification[]
  internProfile     InternProfile?
  supervisorPlacements Placement[] @relation("PlacementSupervisor")
  logEntries           LogEntry[]
  reviewedLogs         LogEntry[]  @relation("LogReviewer")
  supervisorFeedbacks  Feedback[]  @relation("SupervisorFeedback")
  internFeedbacks      Feedback[]  @relation("InternFeedback")
  evaluatedInterns     Evaluation[] @relation("EvaluationSupervisor")
  reviewedEvaluations  Evaluation[] @relation("EvaluationReviewer")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  DEADLINE
  EVALUATION
}

// ==============================
// PERFORMANCE EVALUATION
// ==============================

enum EvaluationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

model Evaluation {
  id              String            @id @default(uuid()) @db.Uuid
  internId        String            @db.Uuid
  supervisorId    String            @db.Uuid
  placementId     String            @db.Uuid
  status          EvaluationStatus  @default(PENDING)
  
  // Evaluation Criteria Scores (1-10)
  attendance      Int?              @db.SmallInt
  technicalSkills Int?              @db.SmallInt
  communication   Int?              @db.SmallInt
  teamwork        Int?              @db.SmallInt
  initiative      Int?              @db.SmallInt
  problemSolving  Int?              @db.SmallInt
  professionalConduct Int?          @db.SmallInt
  
  // Calculated overall score
  overallScore    Float?
  
  // Additional fields
  strengths       String?           @db.Text
  improvements    String?           @db.Text
  comments        String?           @db.Text
  
  // Review tracking
  reviewedBy      String?           @db.Uuid
  reviewedAt      DateTime?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  intern      InternProfile         @relation("EvaluationIntern", fields: [internId], references: [id], onDelete: Cascade)
  supervisor      User              @relation("EvaluationSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)
  reviewer        User?             @relation("EvaluationReviewer", fields: [reviewedBy], references: [id])
  placement       Placement         @relation("PlacementEvaluations", fields: [placementId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@index([supervisorId])
  @@index([placementId])
  @@index([status])
  @@index([createdAt])
  @@map("evaluations")
}

model InternProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  matricNumber     String?   @unique
  faculty          String?
  institution      String?
  avatarUrl        String?   @db.Text
  startDate        DateTime?
  endDate          DateTime?
  supervisorName   String?
  organizationName String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  placements Placement[]
  evaluations Evaluation[] @relation("EvaluationIntern") 

  @@map("intern_profiles")
}

// ==============================
// ORGANIZATION & PLACEMENT
// ==============================

enum IndustrySector {
  TECHNOLOGY
  FINANCE
  HEALTHCARE
  EDUCATION
  ENGINEERING
  MANUFACTURING
  RETAIL
  MEDIA
  CONSULTING
  NON_PROFIT
  GOVERNMENT
  OTHER
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  TERMINATED
  ON_HOLD
  PENDING
}

model Organization {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  address     String?
  email       String?
  phone       String?
  website     String?
  sector      IndustrySector @default(OTHER)
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  placements Placement[]

  @@index([sector])
  @@index([name])
  @@map("organizations")
}

model Placement {
  id             String          @id @default(uuid()) @db.Uuid
  internId       String          @db.Uuid
  organizationId String          @db.Uuid
  supervisorId   String?         @db.Uuid
  status         PlacementStatus @default(ACTIVE)
  role           String?
  department     String?
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  internProfile InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supervisor    User?         @relation("PlacementSupervisor", fields: [supervisorId], references: [id])

  evaluations Evaluation[] @relation("PlacementEvaluations")

  @@unique([internId, organizationId])
  @@index([organizationId])
  @@index([supervisorId])
  @@index([status])
  @@map("placements")
}

// ==============================
// DIGITAL ACTIVITY LOGBOOK
// ==============================

enum LogEntryType {
  DAILY
  WEEKLY
}

enum LogStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model LogEntry {
  id          String       @id @default(uuid()) @db.Uuid
  internId    String       @db.Uuid
  entryType   LogEntryType @default(DAILY)
  status      LogStatus    @default(DRAFT)
  logDate     DateTime
  activity    String       @db.Text
  skills      String?      @db.Text
  hoursWorked Float?
  notes       String?      @db.Text
  reviewedBy  String?      @db.Uuid
  reviewedAt  DateTime?
  reviewNotes String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  intern    User  @relation(fields: [internId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("LogReviewer", fields: [reviewedBy], references: [id])
  feedbacks Feedback[]

  @@index([internId])
  @@index([internId, status])
  @@index([internId, logDate])
  @@index([reviewedBy])
  @@map("log_entries")
}

// ==============================
// SUPERVISOR FEEDBACK
// ==============================

enum FeedbackType {
  GENERAL
  PERFORMANCE
  SKILLS
  CONDUCT
  GOAL
}

model Feedback {
  id          String       @id @default(uuid()) @db.Uuid
  supervisorId String      @db.Uuid
  internId    String       @db.Uuid
  logEntryId  String?      @db.Uuid
  type        FeedbackType @default(GENERAL)
  rating      Int?         @db.SmallInt
  content     String       @db.Text
  strengths   String?      @db.Text
  improvements String?     @db.Text
  isPrivate   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  supervisor User      @relation("SupervisorFeedback", fields: [supervisorId], references: [id], onDelete: Cascade)
  intern     User      @relation("InternFeedback", fields: [internId], references: [id], onDelete: Cascade)
  logEntry   LogEntry? @relation(fields: [logEntryId], references: [id], onDelete: SetNull)

  @@index([supervisorId])
  @@index([internId])
  @@index([logEntryId])
  @@index([createdAt])
  @@map("feedbacks")
}
