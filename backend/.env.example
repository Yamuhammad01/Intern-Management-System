# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/intern_management?schema=public

# JWT
JWT_ACCESS_SECRET=your-access-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Frontend URL(s) allowed by CORS. Comma-separated, no trailing slash.
FRONTEND_URL=http://localhost:5173

# Accept sibling Vercel deployment/preview URLs (e.g. my-app-<hash>.vercel.app) of
# each *.vercel.app origin listed in FRONTEND_URL. Set to "false" to allow only the
# exact origins above.
ALLOW_VERCEL_DEPLOYMENT_URLS=true

# SMTP (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@internmanagement.com